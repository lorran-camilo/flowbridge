# Somente para desenvolvimento local. Troque os valores antes de iniciar os containers.
FLOWBRIDGE_POSTGRES_DB=flowbridge
FLOWBRIDGE_POSTGRES_BOOTSTRAP_USER=flowbridge_bootstrap
FLOWBRIDGE_POSTGRES_BOOTSTRAP_PASSWORD=change-this-bootstrap-password
FLOWBRIDGE_POSTGRES_MIGRATOR_PASSWORD=change-this-migrator-password
FLOWBRIDGE_POSTGRES_API_PASSWORD=change-this-api-password
FLOWBRIDGE_POSTGRES_WORKER_PASSWORD=change-this-worker-password
FLOWBRIDGE_RABBITMQ_USER=flowbridge_dev
FLOWBRIDGE_RABBITMQ_PASSWORD=change-this-rabbitmq-password
FLOWBRIDGE_KEYCLOAK_ADMIN_USER=flowbridge_admin
FLOWBRIDGE_KEYCLOAK_ADMIN_PASSWORD=change-this-keycloak-password
